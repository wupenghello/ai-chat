{
  "name": "ai-chat",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build --base=/ai-chat/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:style": "bash scripts/style-guard.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
