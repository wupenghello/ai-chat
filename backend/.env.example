# 复制为 .env 后填写（.env 不入 git）。统一 key 模式 = 用户零配置直接对话（REQ-023/014，design-iter-7 定夺①）
# 三项都留空时服务可启动，但对话请求会返回「服务端未配置统一密钥，请联系管理员」
AI_CHAT_UNIFIED_KEY=
# 默认上游 DeepSeek（OpenAI 兼容），自建其他兼容网关时改这里
AI_CHAT_UNIFIED_BASE_URL=https://api.deepseek.com
AI_CHAT_UNIFIED_MODEL=deepseek-chat

# 配额四变量（REQ-024，iter-8 T1）：默认值即 app/config.py 定案（CEO 拍板 2026-08-16），0 = 该项不限
AI_CHAT_REGISTER_IP_DAILY_LIMIT=3
AI_CHAT_QUOTA_FREE_DAILY=30
AI_CHAT_QUOTA_SELF_DAILY=500
AI_CHAT_UNIFIED_DAILY_TOTAL=2000

# 联网搜索（REQ-035，iter-14 T2）：Tavily key（plans/iter-14 定夺 1/2）。
# 留空 = 未配置：admin 开关状态可存但 search 工具不注册（design-iter-14 §6.1）；
# admin 后台仅可见「已配置/未配置」，不可见 key 本体
AI_CHAT_SEARCH_KEY=

# 真实天气工具（CHG-016/REQ-053，iter-22 T2）：和风天气（专属 Host 制度账户）。
# Host 填和风控制台分配的专属 API Host（无公共域）；key 与 Host 均配置 weather 工具
# 才注册（任一留空 = 未配置；CHG-016 定夺②不新增 admin 开关——移除 key 重启即下线）
AI_CHAT_WEATHER_KEY=
AI_CHAT_WEATHER_HOST=

# 产品人设（CHG-009/REQ-036）：system[0] 静态前缀内容物（跨请求字节恒定，多行值以双引号包裹）；留空 = 回退基线 v5 单 system 形态
AI_CHAT_PRODUCT_PERSONA=

# 遥测成本单价三变量（CHG-009/REQ-038，定夺⑥）：单位 元/百万 token（DeepSeek 计价口径），
# admin 后台只读；成本口径仅计统一 key 模式（自填模式列 token 不计成本）。
# 留空 = 未配置 → 成本卡不估算并提示未配置（不造数）
AI_CHAT_PRICE_INPUT=
AI_CHAT_PRICE_OUTPUT=
AI_CHAT_PRICE_CACHE_HIT=

# 三级上下文压缩（CHG-010/REQ-039，iter-16 T2）：默认值即 T0 取证定死值
# （阈值 0.75Y 取整千位；微参数定夺⑨ K=2 / R=5 / 30s），如需部署级覆盖改这里
AI_CHAT_COMPACT_THRESHOLD=7000
AI_CHAT_SNIP_KEEP_RECENT_TOOLS=2
AI_CHAT_COMPACT_RECENT_TURNS=5
AI_CHAT_SUMMARY_TIMEOUT=30

# deep-research 双护栏 + SSE 心跳（CHG-012/REQ-045/046，iter-18 T2）：默认值即 T0 取证定死值
# （plans/iter-18-verify.md §2/§3：心跳 20s 经本地 nginx 反代实测定档；护栏 16 步 + 900s
# 授权内零调整）。心跳对全部回合生效；间隔非法值 ≤0 由服务端兜底 20s。
# CHG-018（直派批次）：上两行语义收窄为 standard 档；下四行为 light/deep 档护栏
# + research 回合上游载荷输出上限（T0 定死 plans/chg-018-verify.md §3/§6——不带
# max_tokens 时 DeepSeek 默认 4096 tokens 会截断深度档报告）
AI_CHAT_MAX_RESEARCH_STEPS=16
AI_CHAT_RESEARCH_TOTAL_TIMEOUT=900
AI_CHAT_HEARTBEAT_INTERVAL=20
AI_CHAT_RESEARCH_STEPS_LIGHT=8
AI_CHAT_RESEARCH_TIMEOUT_LIGHT=300
AI_CHAT_RESEARCH_STEPS_DEEP=32
AI_CHAT_RESEARCH_TIMEOUT_DEEP=900
AI_CHAT_RESEARCH_MAX_TOKENS=8192
